        "channel_modes": ["mono", "dual_channel", "stereo", "joint_stereo"],
        "block_lengths": [4, 8, 12, 16],
        "subbands": [4, 8],
        "allocation_methods": ["snr", "loudness"],
        "min_bitpool": 2,
        "max_bitpool": 53
