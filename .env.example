# vmhub secrets — variable NAMES only. Values live in Doppler (project: proxmox,
# config: prd), managed via `doppler secrets set` / the dashboard. Local .env is
# a deprecated fallback for the desktop mock stage only; never commit real values.
#
# Copy this file: cp .env.example .env
# Then fill in the REQUIRED variables below.

# =============================================================================
# REQUIRED — Proxmox (runtime credential: scoped API token, not root password)
# =============================================================================

# MUST include port. Proxmox listens on 8006, not 443.
# Wrong: PVE_HOST=192.168.1.220
# Right: PVE_HOST=192.168.1.220:8006
PVE_HOST=

# Token ID format: <user>@pve!<token-name>
# Default from bootstrap/post-install.sh: vmhub@pve!automation
PVE_TOKEN_ID=vmhub@pve!automation

# Token secret value (the "private" part of the API token)
PVE_TOKEN=

# =============================================================================
# OPTIONAL — CursorTouch (Windows-MCP in the win11-24h2 golden)
# =============================================================================
# Required only for Windows VMs. The Windows adapter uses this key to reach
# the in-VM MCP server on :8000. Without it, Windows templates return
# CAPABILITY_UNAVAILABLE.
#
# For local setups: generate a random string (e.g. openssl rand -hex 32)
# and configure the same value inside the Windows golden image.
# For production: use Doppler, Vault, or another secrets manager.
CURSORTOUCH_AUTH_KEY=

# =============================================================================
# OPTIONAL — iLO (provision-only; used once to install Proxmox + bootstrap)
# =============================================================================
ILO_HOST=
ILO_USERNAME=
ILO_PASSWORD=

# =============================================================================
# OPTIONAL — Proxmox root (install-time; in Doppler as PVE_ROOT_PW)
# =============================================================================
PVE_ROOT_PW=

# =============================================================================
# OPTIONAL — GitHub App (per-lease installation tokens for VM repo access)
# =============================================================================
GH_APP_ID=
GH_APP_INSTALLATION_ID=
GH_APP_PRIVATE_KEY=

# Comma-separated list of repos the VM may access (e.g. "org/repo1,org/repo2")
GH_ALLOWED_REPOS=

# =============================================================================
# OPTIONAL — Multi-node (skip for single-node setups)
# =============================================================================
# Comma-separated node IDs (e.g. "DL360P,DL380G9")
VMHUB_NODES=

# Per-node variables: replace <ID> with each node ID from VMHUB_NODES
# VMHUB_NODE_DL360P_BASE_URL=
# VMHUB_NODE_DL360P_TOKEN=
# VMHUB_NODE_DL380G9_BASE_URL=
# VMHUB_NODE_DL380G9_TOKEN=

# =============================================================================
# OPTIONAL — Control plane (vmhub-lite)
# =============================================================================

# Port the REST server listens on (default: 8787)
# VMHUB_PORT=8787

# SQLite database path (default: <VMHUB_LEASE_DIR>/leases.sqlite)
# VMHUB_DB=

# Directory for lease scratch files (default: ./leases)
# VMHUB_LEASE_DIR=./leases

# Directory for file transfer artifacts (default: ./artifacts)
# VMHUB_ARTIFACT_DIR=./artifacts

# Percentage of disk free below which destructive operations are refused (default: 15)
# VMHUB_DISK_FULL_REFUSAL_PCT=15

# Proxmox storage target for cloned disks (default: local-lvm)
# PVE_STORAGE=local-lvm

# =============================================================================
# OPTIONAL — MCP server (vmhub-mcp)
# =============================================================================

# Where the MCP server finds the control plane (default: http://127.0.0.1:8787)
# VMHUB_LITE_URL=http://127.0.0.1:8787

# Where screenshots are saved (default: ~/Pictures/vmhub)
# VMHUB_SCREENSHOT_DIR=~/Pictures/vmhub

# =============================================================================
# OPTIONAL — SSH transport (for Hyprland/X11 adapters)
# =============================================================================

# SSH key for connecting to VMs (default: ~/.ssh/vmhub_rsa)
# VMHUB_SSH_KEY=~/.ssh/vmhub_rsa

# SSH user inside VMs (default: vmhub)
# VMHUB_SSH_USER=vmhub

# Proxmox host used as SSH jump target (default: 192.168.1.220)
# VMHUB_JUMP_HOST=192.168.1.220

# =============================================================================
# OPTIONAL — Adapter ports
# =============================================================================

# CursorTouch in-VM MCP port (default: 8000)
# CURSORTOUCH_PORT=8000

# ADB port for Android VMs (default: 5555)
# ADB_PORT=5555

# =============================================================================
# OPTIONAL — Feature flags and tuning
# =============================================================================

# Drain protection: reject tool calls during shutdown (default: true)
# VMHUB_TOOL_DRAIN=false

# Template cache TTL in ms (default: 60000)
# VMHUB_TEMPLATE_CACHE_TTL_MS=60000

# Cooldown between lease creations in ms (default: 5000)
# VMHUB_LEASE_CREATE_COOLDOWN_MS=5000

# Collision quarantine: quarantine VMs with duplicate tags (default: true)
# VMHUB_COLLISION_QUARANTINE=false

# Provisioning status: show templates as available (default: true)
# VMHUB_PROVISIONING_STATUS=false

# Locked create: serialize VM creation per node (default: true)
# VMHUB_LOCKED_CREATE=false
